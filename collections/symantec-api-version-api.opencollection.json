{
  "opencollection": "1.0.0",
  "info": {
    "name": "Symantec Endpoint Protection Manager Administrators API Version API",
    "version": "14.0"
  },
  "items": [
    {
      "info": {
        "name": "API Version",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{sepm-host}:8446/sepm/api/v1/api-stats/version",
